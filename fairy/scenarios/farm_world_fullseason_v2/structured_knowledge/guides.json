  "guides": {
    "planting_readiness": {
      "title": "播前条件与种子设备检查",
      "applicable_when": "任务涉及播种或分批播种，需要判断播床、天气及资源是否允许开始作业。",
      "guidance": [
        "播种前共同检查当前天气和短期预报、土壤温度与水分、播床状态，以及拖拉机等播种设备和目标种子库存。",
        "仅在天气和播床条件适合时进入播种；条件不适合时等待合适窗口，不能把计划时间直接当作无条件开工指令。",
        "使用当前任务指定的品种、分区及播种参数装种和播种，完成播种状态更新。"
      ],
      "source_evidence": [
        {
          "scenario_id": "scenario_full_season_heinong84_staggered_planting",
          "source_start_line": 72,
